[
  {
    "id": "articles",
    "name": "articles",
    "label": "Artículos",
    "type": "group",
    "occurrence": { "min": 1, "max": 12, "default": 3 },
    "children": [
      {
        "id": "image",
        "name": "image",
        "label": "Imagen",
        "type": "image",
        "required": false,
        "default": { "alt": "", "loading": "lazy" }
      },
      {
        "id": "date",
        "name": "date",
        "label": "Fecha",
        "type": "text",
        "default": "dic 2, 2025"
      },
      {
        "id": "title",
        "name": "title",
        "label": "Título",
        "type": "text",
        "default": "Título del artículo"
      },
      {
        "id": "excerpt",
        "name": "excerpt",
        "label": "Extracto",
        "type": "text",
        "default": "Breve descripción del artículo que invita al lector a conocer más."
      },
      {
        "id": "link",
        "name": "link",
        "label": "Enlace del artículo",
        "type": "link",
        "default": {
          "url": { "href": "#", "type": "EXTERNAL" },
          "open_in_new_tab": false
        }
      }
    ]
  },
  {
    "id": "read_more_text",
