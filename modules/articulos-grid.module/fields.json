    "default": "Leer más"
  },
  {
    "id": "columns",
    "name": "columns",
    "label": "Columnas",
    "type": "choice",
    "display": "radio",
    "choices": [
      ["2", "2 columnas"],
      ["3", "3 columnas"],
      ["4", "4 columnas"]
    ],
    "default": "3"
  },
  {
    "id": "image_ratio",
    "name": "image_ratio",
    "label": "Relación de aspecto de imagen",
    "type": "choice",
    "display": "select",
    "choices": [
      ["16/9", "16:9 — Paisaje"],
      ["3/2",  "3:2"],
      ["4/3",  "4:3"],
      ["1/1",  "1:1 — Cuadrado"]
    ],
    "default": "16/9"
  },
  {
    "id": "image_radius",
    "name": "image_radius",
    "label": "Radio de bordes de imagen (px)",
    "type": "number",
    "default": 8,
    "min": 0,
    "max": 24
